# Copy this file to .env and fill in your values
 
# ── Data Source Configuration ────────────────────────────────────────────────
# Controls where the dashboard reads data from:
#   snapshot  → Read-only versioned repository snapshot (sampleData.js)
#               Safe for demos, hackathons, and offline use. DEFAULT.
#   database  → Live database via REST API (falls back to snapshot if DB unreachable)
VITE_DATA_SOURCE=snapshot
 
# ── API Base URL (required only when VITE_DATA_SOURCE=database) ──────────────
VITE_API_BASE_URL=http://localhost:8080/api/v1